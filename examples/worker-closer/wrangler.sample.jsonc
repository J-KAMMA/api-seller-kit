{
  // Closes prepaid channels on a timer (Avalanche Fuji testnet only). Secrets: SELLER_PRIVATE_KEY (a key that only receives earnings)
  // and STORE_SECRET (the same as the seller Worker's): wrangler secret put SELLER_PRIVATE_KEY / STORE_SECRET.
  // A seller Worker on the same Cloudflare account: uncomment the service binding below (its public address cannot be fetched from here).
  "name": "jkamma-api-prepaid-closer-testnet",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "services": [{ "binding": "SELLER_WORKER", "service": "jkamma-api-prepaid-testnet" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "NETWORK": "eip155:43113",
    "RPC_URL": "https://api.avax-test.network/ext/bc/C/rpc",
    "CHANNEL_CONTRACT": "0xA5E4707344b624A7217b7814dA1b3611Bf4b4559",
    "STORE_URL": "https://jkamma-api-prepaid-testnet.jkamma-hub.workers.dev/__seller-store",
    "WAIT_SECONDS": "30",
    "MIN_AMOUNT": "1000000",
    "MAX_FEE_GWEI": "200",
    "MAX_SUBREQUESTS": "45"
  }
}
